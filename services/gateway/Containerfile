# The gateway's image: its static binary and nothing else -- no shell,
# no package manager -- run as an unprivileged user (roadmap R-120,
# R-135). script/image builds the binary with the pinned toolchain, so
# the image has no base to trust or pin.
FROM scratch
COPY gateway /gateway
USER 65532:65532
ENV URSHANABI_LISTEN=0.0.0.0:8080
EXPOSE 8080
ENTRYPOINT ["/gateway"]
