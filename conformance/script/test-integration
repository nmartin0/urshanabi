#!/bin/sh
# conformance/script/test-integration: check Urshanabi, black-box through
# its driver, against every property implemented from
# conformance/BEHAVIOURS.md (roadmap R-07). Properties are discovered,
# never listed, and requests alternate between two replicas of every
# service (R-18). A failure fails the run; a pending property is
# reported with the roadmap item it waits for.
set -u
cd "$(dirname "$0")/../.." || exit 1
PATH="$PWD/.tools/bin:$PATH"
WORK=$(mktemp -d) || exit 1
STACK="conformance-$$"
PORT=$((30000 + $$ % 20000))
DRIVER="$PWD/conformance/drivers/urshanabi"
INTERPRETER=$(script/pipeline-toolchain) || exit 1
PYTHONPATH="$PWD/conformance"  # name-ok
export PATH WORK STACK PORT DRIVER PYTHONPATH  # name-ok
STORE_PORT=$((PORT + 100))
CATALOG_PORT=$((PORT + 200))
export STORE_PORT CATALOG_PORT
stop_stores() { for d in conformance/stores/drivers/* conformance/catalogs/drivers/*; do [ -x "$d" ] && "$d" stop; done; }
trap '"$DRIVER" stop; stop_stores; rm -rf "$WORK"' EXIT
"$DRIVER" start || { echo "conformance: FAILED: the stack did not start"; exit 1; }

found=0; passed=0; pending=0; failed=""
for p in conformance/properties/*; do
    case "$p" in
        *.py) set -- "$INTERPRETER" "$p" ;;
        *) [ -x "$p" ] || continue; set -- "$p" ;;
    esac
    found=$((found + 1))
    id=${p##*/}; id=${id%.py}
    out=$("$@"); rc=$?
    case $rc in
        0) passed=$((passed + 1)); echo "  pass     $id" ;;
        2) pending=$((pending + 1)); echo "  pending  $id: $out" ;;
        *) failed="$failed $id"; echo "  FAIL     $id: $out" ;;
    esac
done
[ "$found" -gt 0 ] || { echo "conformance: FAILED: no properties found"; exit 1; }
# The properties held against two replicas only if both answered (R-18).
for r in a b; do
    n=$("$DRIVER" answered "$r")
    [ "$n" -gt 0 ] || { echo "conformance: FAILED: replica $r answered no requests, so the replicas were not both exercised"; exit 1; }
done
# The object-storage checks (R-139): every supported store must pass every
# check, each store started by its own driver.
checks=0
for d in conformance/stores/drivers/*; do
    [ -x "$d" ] || continue
    store=${d##*/}
    if ! "$d" start; then failed="$failed $store"; echo "  FAIL     $store: the store did not start"; continue; fi
    while IFS='=' read -r key value; do export "$key=$value"; done < "$WORK/store.env"
    for c in conformance/stores/checks/*; do
        [ -x "$c" ] || continue
        out=$("$c"); rc=$?
        if [ "$rc" -eq 0 ]; then checks=$((checks + 1)); echo "  pass     $store: ${c##*/}"
        else failed="$failed $store:${c##*/}"; echo "  FAIL     $store: ${c##*/}: $out"; fi
    done
    "$d" stop
done
[ "$checks" -gt 0 ] || { echo "conformance: FAILED: no store checks ran"; exit 1; }

# The table catalog's checks (R-139, R-111), each catalog over its own
# development store.
catalog_checks=0
for d in conformance/catalogs/drivers/*; do
    [ -x "$d" ] || continue
    catalog=${d##*/}
    if ! out=$("$d" start); then failed="$failed $catalog"; echo "  FAIL     $catalog: $out"; continue; fi
    while IFS='=' read -r key value; do export "$key=$value"; done < "$WORK/catalog.env"
    for c in conformance/catalogs/checks/*; do
        [ -x "$c" ] || continue
        out=$("$c"); rc=$?
        if [ "$rc" -eq 0 ]; then catalog_checks=$((catalog_checks + 1)); echo "  pass     $catalog: ${c##*/}"
        else failed="$failed $catalog:${c##*/}"; echo "  FAIL     $catalog: ${c##*/}: $out"; fi
    done
    "$d" stop
done
[ "$catalog_checks" -gt 0 ] || { echo "conformance: FAILED: no catalog checks ran"; exit 1; }

if [ -n "$failed" ]; then
    echo "conformance: FAILED:$failed"
    exit 1
fi
echo "conformance: $passed properties hold, $pending pending; $checks store checks and $catalog_checks catalog checks hold."
