#!/bin/sh
# conformance/catalogs/request METHOD PATH [EXTRA-ARGUMENT...]: one call to
# the catalog under test with a fresh access token; the body lands in
# $WORK/body and the status is printed. $CATALOG_URL, $CATALOG_CLIENT and
# $CATALOG_SECRET come from the catalog's driver.
set -u
method=$1; path=$2; shift 2
token=$(curl -s "$CATALOG_URL/api/catalog/v1/oauth/tokens" -d grant_type=client_credentials -d "client_id=$CATALOG_CLIENT" -d "client_secret=$CATALOG_SECRET" -d scope=PRINCIPAL_ROLE:ALL | sed -n 's/.*"access_token":"\([^"]*\)".*/\1/p')  # name-ok
curl -s -X "$method" -o "$WORK/body" -w '%{http_code}' -H "Authorization: Bearer $token" -H 'Content-Type: application/json' "$@" "$CATALOG_URL$path" || echo 000  # name-ok
