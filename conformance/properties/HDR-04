#!/bin/sh
# conformance/properties/HDR-04: no machine-readable description of the interface is served
# (conformance/BEHAVIOURS.md). Exits 0 when it holds, 1 when it does
# not, 2 when Urshanabi cannot yet be held to it.
set -u
for path in /openapi.json /openapi.yaml /swagger.json /v1/openapi.json /docs /api-docs; do  # name-ok
    "$DRIVER" request GET "$path" || { echo "$path: no answer"; exit 1; }
    status=$(cat "$WORK/status")
    [ "$status" = 404 ] || { echo "$path answered $status, not 404"; exit 1; }
done
