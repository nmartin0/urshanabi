#!/bin/sh
# script/test: every repository check (each executable script/check-*,
# discovered, never listed), then every component's own script/test.
# Reports every failure together. Deliberately no "set -e".
set -u
cd "$(dirname "$0")/.." || exit 1
PATH="$PWD/.tools/bin:$PATH"
export PATH

checks=0
failed=""
for check in script/check-*; do
    [ -f "$check" ] || continue
    if [ ! -x "$check" ]; then
        echo "FAIL $check: not executable"
        failed="$failed $check"
        continue
    fi
    checks=$((checks + 1))
    printf '=== %s\n' "$check"
    "$check" || failed="$failed $check"
done

if [ "$checks" -eq 0 ]; then
    echo "FAIL: no repository checks found; is this the repository root?"
    exit 1
fi

printf '=== components\n'
# The fast tier needs nothing outside the repository (roadmap R-02), so
# every variable that could name an external service or a credential is
# cleared before any component's tests run. A test that quietly used a
# developer's database, endpoint or key then fails here, rather than on
# somebody else's fresh clone.
set --
for name in $(env | sed 's/=.*//'); do
    case "$name" in
        *_URL | *_DSN | *_ENDPOINT | *_ADDRESS | *_PASSWORD | *_SECRET | *_TOKEN | *_KEY | AWS_* | STORE_* | CATALOG_*)
            set -- "$@" -u "$name" ;;
    esac
done
env "$@" ./script/each-component test || failed="$failed components"

echo
if [ -n "$failed" ]; then
    echo "script/test FAILED:$failed"
    exit 1
fi
echo "script/test passed: $checks repository checks, and every component."
