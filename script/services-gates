#!/bin/sh
# script/services-gates DIR: the services-language gates for the component
# in DIR (RULES.md E3), shared so every component runs the same ones: code
# generation; formatting; vet; tests under the race detector, in UTC, a
# zone behind it and a zone observing daylight saving (roadmap R-14); and
# the modules gate -- every module matches its recorded hash, and the
# module manifest and its lockfile are tidy (R-10).
set -u
dir=${1:-}
[ -n "$dir" ] || { echo "usage: script/services-gates DIR" >&2; exit 2; }
cd "$(dirname "$0")/.." || exit 1
PATH="$PWD/.tools/bin:$PATH"
export PATH
name=${dir##*/}
failed=""
run() {  # run GATE COMMAND...
    gate=$1; shift
    echo "$name: $gate"
    "$@" || failed="$failed $gate"
}
unformatted() {
    out=$(gofmt -l "$dir" | grep -v '/internal/gen/')  # name-ok
    [ -z "$out" ] || { echo "$out"; return 1; }
}
if [ -x "$dir/script/generate" ]; then
    run generation "$dir/script/generate"
fi
run formatting unformatted
run vet go vet "./$dir/..."  # name-ok
for zone in UTC America/Sao_Paulo America/New_York; do
    run "tests-$zone" env TZ="$zone" go test -race -count=1 "./$dir/..."  # name-ok
done
run modules sh -c 'go mod verify && go mod tidy -diff'  # name-ok
if [ -n "$failed" ]; then
    echo "$name: FAILED:$failed"
    exit 1
fi
echo "$name: every gate passed."
