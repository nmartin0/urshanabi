#!/bin/sh
# script/check-secrets: no credential has ever been committed, anywhere
# in the history (roadmap R-86, R-92).
set -u
cd "$(dirname "$0")/.." || exit 1
command -v gitleaks >/dev/null 2>&1 ||  # name-ok
    { echo "FAIL: the secret scanner is not installed; run script/bootstrap"; exit 1; }
if gitleaks git --redact --no-banner --log-level warn .; then  # name-ok
    echo "check-secrets: history clean."
else
    echo "check-secrets FAILED"; exit 1
fi
