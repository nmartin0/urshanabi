#!/bin/sh
# script/check-inventory: the asset inventory matches the repository
# (roadmap R-123). It is generated by script/inventory from what each
# component and the dependency register already record, so a component,
# dependency or flow added without regenerating it fails here, and the
# inventory can never quietly describe a system we no longer have.
set -u
cd "$(dirname "$0")/.." || exit 1
[ -f docs/inventory.md ] || { echo "FAIL: there is no asset inventory; run script/inventory > docs/inventory.md"; exit 1; }
current=$(mktemp) || exit 1
trap 'rm -f "$current"' EXIT
script/inventory > "$current" || { echo "FAIL: the inventory could not be generated"; exit 1; }
if ! diff -u docs/inventory.md "$current" > /dev/null; then
    echo "INVENTORY: docs/inventory.md no longer matches the repository:"
    diff -u docs/inventory.md "$current" | sed -n 's/^[+-][^+-]/  &/p' | head -12
    echo "check-inventory FAILED: run script/inventory > docs/inventory.md"
    exit 1
fi
components=$(grep -c '^| `' docs/inventory.md)
echo "check-inventory: the inventory matches the repository; $components rows."
