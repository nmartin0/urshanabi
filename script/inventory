#!/bin/sh
# script/inventory: write the asset inventory from what the repository
# already records (roadmap R-123) -- every component with its role, what
# it holds and what it speaks to, every dependency we chose, and the
# flows between components. It is generated, never written by hand, so
# it cannot drift from the thing it describes; script/check-inventory
# fails the build when it has.
set -u
cd "$(dirname "$0")/.." || exit 1

# field FILE NAME: one README field, its wrapped lines joined.
field() {
    awk -v want="- **$2:**" '
        index($0, want) == 1 { found = 1; sub(/^- \*\*[^*]*:\*\* /, ""); printf "%s", $0; next }
        found && /^- \*\*/ { exit }
        found && /^  / { sub(/^  /, " "); printf "%s", $0; next }
        found { exit }
    ' "$1"
}

printf '# Asset inventory\n\n'
printf "Generated by \`script/inventory\` from the repository itself\n"
printf '(roadmap R-123). Do not edit: run the script. Reviewed on every\n'
printf 'significant change, and at least every twelve months.\n'

printf '\n## Components\n\n'
printf '| Component | Language role | Holds | Speaks to |\n'
printf '|---|---|---|---|\n'
for readme in $(git ls-files '*/README.md' | sort); do  # name-ok
    dir=${readme%/README.md}
    case "$dir" in */*) continue ;; esac
    role=$(field "$readme" "Language role")
    [ -n "$role" ] || continue
    printf "| \`%s\` | %s | %s | %s |\n" "$dir" "$role" \
        "$(field "$readme" "Holds")" "$(field "$readme" "Speaks to")"
done
for readme in $(git ls-files 'services/*/README.md' 'libs/*/README.md' | sort); do  # name-ok
    dir=${readme%/README.md}
    printf "| \`%s\` | %s | %s | %s |\n" "$dir" "$(field "$readme" "Language role")" \
        "$(field "$readme" "Holds")" "$(field "$readme" "Speaks to")"
done

printf '\n## Flows\n\n'
printf 'What each component speaks to, from its own record.\n\n'
for readme in $(git ls-files 'services/*/README.md' | sort); do  # name-ok
    dir=${readme%/README.md}
    printf -- "- \`%s\` → %s\n" "$dir" "$(field "$readme" "Speaks to")"
done

printf '\n## Dependencies we chose\n\n'
printf '| Dependency | Licence | Inside a cell |\n'
printf '|---|---|---|\n'
awk '
    /^\[/ { name = $0; gsub(/[][]/, "", name) }
    /^licence = / { sub(/^licence = /, ""); licence[name] = $0 }
    /^shipped = / { sub(/^shipped = /, ""); shipped[name] = $0; order[++n] = name }
    END { for (i = 1; i <= n; i++) printf "| `%s` | %s | %s |\n", order[i], licence[order[i]], shipped[order[i]] }
' script/dependencies.register
