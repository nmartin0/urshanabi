parsers o5; printf 'path := "ontology/types/customer.toml"\n' > "$t/services/x/main.go"  # name-ok
expect_msg fail "code naming a definition file fails" "names an ontology definition file" "$t/script/check-ontology-parsers"


# --- the services-language gates (R-127): each fails on a planted fault
# A helper that writes a module zip, with only the standard library.
cat > "$base/mkzip.go" <<'GOSRC'  # name-ok
// mkzip writes a module zip: mkzip DIR MODULE@VERSION OUT.
package main

import (
	"archive/zip"
	"os"
	"path/filepath"
)

func main() {
	dir, prefix, out := os.Args[1], os.Args[2]+"/", os.Args[3]
	f, err := os.Create(out)
	if err != nil {
		panic(err)
	}
	z := zip.NewWriter(f)
	err = filepath.WalkDir(dir, func(p string, e os.DirEntry, err error) error {
		if err != nil || e.IsDir() {
			return err
		}
		rel, _ := filepath.Rel(dir, p)
		w, err := z.Create(prefix + filepath.ToSlash(rel))
		if err != nil {
			return err
		}
		b, err := os.ReadFile(p)
		if err != nil {
			return err
		}
		_, err = w.Write(b)
		return err
	})
	if err != nil {
		panic(err)
	}
	if err := z.Close(); err != nil {
		panic(err)
	}
}
GOSRC
# The real component script, run against a dependency-free module.
svcmod() {  # svcmod NAME: a one-package module with the gateway's gates
    tree "$1" services-gates
    mkdir -p "$t/services/gateway/script" "$t/services/gateway/fixture"
    cp "$repo/services/gateway/script/test" "$t/services/gateway/script/" || exit 1
    printf 'module urshanabi\n\ngo 1.27\n' > "$t/go.mod"  # name-ok
    printf 'package fixture\n\n// Double doubles a number.\nfunc Double(n int) int {\n\treturn n * 2\n}\n' > "$t/services/gateway/fixture/fixture.go"  # name-ok
    printf 'package fixture\n\nimport "testing"\n\nfunc TestDouble(t *testing.T) {\n\tif Double(2) != 4 {\n\t\tt.Fatal("wrong")\n\t}\n}\n' > "$t/services/gateway/fixture/fixture_test.go"  # name-ok
    # A program, so dead code has something to be unreachable from.
    mkdir -p "$t/services/gateway/cmd/fixture" "$t/.tools/bin" "$t/vulndb/index" "$t/vulndb/ID"
    printf 'package main\n\nimport "urshanabi/services/gateway/fixture"\n\nfunc main() { _ = fixture.Double(1) }\n' > "$t/services/gateway/cmd/fixture/main.go"  # name-ok
    for tool in deadcode govulncheck; do ln -s "$repo/.tools/bin/$tool" "$t/.tools/bin/$tool"; done  # name-ok
    # An empty vulnerability database, so the gate never needs the network.
    printf '{"modified":"2026-01-01T00:00:00Z"}' > "$t/vulndb/index/db.json"
    printf '[]' > "$t/vulndb/index/modules.json"
    URSHANABI_VULNDB="file://$t/vulndb"
    export URSHANABI_VULNDB
}
# vulnerable NAME CALL: a fixture requiring a module with one planted
# vulnerability, in its function Bad, served at a real version from a
# fixture proxy; the program calls CALL, Bad or Good.
vulnerable() {
    svcmod "$1"
    m="$t/fake"; p="$t/proxy/example.com/vulnerable/@v"
    mkdir -p "$m" "$p"
    printf 'module example.com/vulnerable\n\ngo 1.27\n' > "$m/go.mod"  # name-ok
    printf 'package vulnerable\n\n// Bad is vulnerable.\nfunc Bad() int { return 1 }\n\n// Good is not.\nfunc Good() int { return 2 }\n' > "$m/v.go"  # name-ok
    (cd "$base" && go run "$base/mkzip.go" "$m" example.com/vulnerable@v1.0.0 "$p/v1.0.0.zip") || exit 1  # name-ok
    cp "$m/go.mod" "$p/v1.0.0.mod"  # name-ok
    printf '{"Version":"v1.0.0","Time":"2026-01-01T00:00:00Z"}' > "$p/v1.0.0.info"
    printf 'v1.0.0\n' > "$p/list"
    printf '[{"path":"example.com/vulnerable","vulns":[{"id":"GO-2026-0001","modified":"2026-01-01T00:00:00Z","fixed":"1.0.1"}]}]' > "$t/vulndb/index/modules.json"  # name-ok
    printf '{"schema_version":"1.3.1","id":"GO-2026-0001","modified":"2026-01-01T00:00:00Z","published":"2026-01-01T00:00:00Z","summary":"A planted vulnerability","details":"For the gate self-test.","affected":[{"package":{"name":"example.com/vulnerable","ecosystem":"Go"},"ranges":[{"type":"SEMVER","events":[{"introduced":"0"},{"fixed":"1.0.1"}]}],"ecosystem_specific":{"imports":[{"path":"example.com/vulnerable","symbols":["Bad"]}]}}]}' > "$t/vulndb/ID/GO-2026-0001.json"  # name-ok
    printf 'package main\n\nimport (\n\t"example.com/vulnerable"\n\n\t"urshanabi/services/gateway/fixture"\n)\n\nfunc main() { _ = fixture.Double(vulnerable.%s()) }\n' "$2" > "$t/services/gateway/cmd/fixture/main.go"  # name-ok
    printf '\nrequire example.com/vulnerable v1.0.0\n' >> "$t/go.mod"  # name-ok
    (cd "$t" && env GOPROXY="file://$t/proxy" GOSUMDB=off GOFLAGS=-mod=mod go mod tidy) || exit 1  # name-ok
}
svcmod g1
expect pass "a clean module passes every services-language gate" "$t/services/gateway/script/test"
svcmod g2; plant 's/return n \* 2/return n*2 /' services/gateway/fixture/fixture.go  # name-ok
expect_msg fail "badly formatted code fails the formatting gate" "FAILED: formatting" "$t/services/gateway/script/test"
svcmod g3; printf '\n// Show prints.\nfunc Show() string {\n\treturn fmt.Sprintf("%%d")\n}\n' >> "$t/services/gateway/fixture/fixture.go"; plant 's/^package fixture$/package fixture\n\nimport "fmt"/' services/gateway/fixture/fixture.go  # name-ok
expect_msg fail "a vet finding fails the vet gate" "FAILED: vet" "$t/services/gateway/script/test"
svcmod g4; plant 's/Double(2) != 4/Double(2) != 5/' services/gateway/fixture/fixture_test.go  # name-ok
expect_msg fail "a failing test fails the tests gate" "FAILED: tests-UTC" "$t/services/gateway/script/test"
svcmod g5; printf 'package fixture\n\nimport (\n\t"testing"\n\t"time"\n)\n\nfunc TestAssumesUTC(t *testing.T) {\n\tif _, offset := time.Now().Zone(); offset != 0 {\n\t\tt.Fatal("local time is not UTC")\n\t}\n}\n' > "$t/services/gateway/fixture/zone_test.go"  # name-ok
expect_msg fail "a local-time read fails under both non-UTC zones, and only them" "FAILED: tests-America/Sao_Paulo tests-America/New_York$" "$t/services/gateway/script/test"
svcmod g6; printf '\nrequire example.com/unused v1.0.0\n' >> "$t/go.mod"  # name-ok
expect_msg fail "an untidy module manifest fails the modules gate" "FAILED: modules" "$t/services/gateway/script/test"
svcmod g7; printf '\n// Unused is called by nothing.\nfunc Unused() int {\n\treturn 0\n}\n' >> "$t/services/gateway/fixture/fixture.go"  # name-ok
expect_msg fail "an unreachable function fails the dead-code gate" "FAILED: dead-code" "$t/services/gateway/script/test"
vulnerable g8 Bad
expect_msg fail "calling a vulnerable function fails the vulnerabilities gate" "FAILED: vulnerabilities" env GOPROXY="file://$t/proxy" GOSUMDB=off "$t/services/gateway/script/test"  # name-ok
vulnerable g9 Good
expect pass "a vulnerable module whose flaw is never called passes" env GOPROXY="file://$t/proxy" GOSUMDB=off "$t/services/gateway/script/test"  # name-ok
unset URSHANABI_VULNDB


# --- check-generated: generated state is never tracked (R-11) ---------
generated() {  # generated NAME DIR: a component whose generator writes into DIR
    tree "$1" check-generated
    mkdir -p "$t/services/x/script"
    printf '/target/\n/services/x/gen/\n' > "$t/.gitignore"
    printf '#!/bin/sh\nmkdir -p %s && echo made > %s/file\n' "$t/services/x/$2" "$t/services/x/$2" > "$t/services/x/script/generate"
    chmod +x "$t/services/x/script/generate"
}
generated e1 gen
expect pass "a generator writing only ignored paths passes" "$t/script/check-generated"
generated e2 made
expect_msg fail "a generator writing an unignored file fails" "services/x/made/" "$t/script/check-generated"
generated e3 gen; printf '/services/x/gen/\n' > "$t/.gitignore"
expect_msg fail "an unignored build directory fails" "target, is not ignored" "$t/script/check-generated"


# --- the agent and pipeline language's gates (R-127) ------------------
# The real component script, run against a small component whose tools
# and interpreter are the ones this repository already built.
pipemod() {  # pipemod NAME: a component in that language, with its gates
    tree "$1" pipeline-gates pipeline-toolchain
    mkdir -p "$t/.tools/opt" "$t/thing/tests" "$t/thing/script"
    for kit in interpreter pipeline-tools; do ln -s "$repo/.tools/opt/$kit" "$t/.tools/opt/$kit"; done
    cp "$repo/pyproject.toml" "$repo/pylock.toml" "$repo/script/interpreter.lock" "$t/" 2>/dev/null
    cp "$repo/script/interpreter.lock" "$t/script/" || exit 1
    cat > "$t/thing/script/test" <<'COMPONENT'
#!/bin/sh
set -u
cd "$(dirname "$0")/../.." || exit 1
exec script/pipeline-gates thing
COMPONENT
    chmod +x "$t/thing/script/test"
    printf '"""A fixture."""\n\n\ndef double(number: int) -> int:\n    """Double a number."""\n    return number * 2\n' > "$t/thing/work.py"
    printf '"""Its tests."""\n' > "$t/thing/tests/__init__.py"
    printf '"""The fixture works."""\n\nimport unittest\n\nimport work\n\n\nclass WorkTest(unittest.TestCase):\n    """Doubling."""\n\n    def test_doubles(self) -> None:\n        """Two doubled is four."""\n        self.assertEqual(work.double(2), 4)\n' > "$t/thing/tests/test_work.py"
}
pipemod p1
expect pass "a clean component passes every gate of that language" "$t/thing/script/test"
pipemod p2; plant 's/    return number \* 2/    return number*2/' thing/work.py
expect_msg fail "badly formatted code fails the formatting gate" "FAILED: formatting" "$t/thing/script/test"
pipemod p3
cat > "$t/thing/work.py" <<'UNUSED'
"""A fixture."""

import json


def double(number: int) -> int:
    """Double a number."""
    return number * 2
UNUSED
expect_msg fail "an unused import fails the lint gate" "FAILED: lint" "$t/thing/script/test"
pipemod p4
cat >> "$t/thing/work.py" <<'WRONGTYPE'


def wrong(number: int) -> str:
    """Return the wrong type."""
    return number
WRONGTYPE
expect_msg fail "a wrong type fails the types gate" "FAILED: types" "$t/thing/script/test"
pipemod p5; plant 's/work.double(2), 4/work.double(2), 5/' thing/tests/test_work.py
expect_msg fail "a failing test fails the tests gate" "FAILED: tests-UTC" "$t/thing/script/test"
pipemod p6
cat > "$t/thing/tests/test_zone.py" <<'LOCALTIME'
"""A local-time read."""

import datetime
import unittest


class ZoneTest(unittest.TestCase):
    """Assumes the host keeps UTC."""

    def test_assumes_utc(self) -> None:
        """The host is in UTC."""
        offset = datetime.datetime.now().astimezone().utcoffset()
        self.assertEqual(offset, datetime.timedelta(0))
LOCALTIME
expect_msg fail "a local-time read fails under both non-UTC zones, and only them" "FAILED: tests-America/Sao_Paulo tests-America/New_York$" "$t/thing/script/test"


# --- check-rungs: every direct dependency records its rung (E1) -------
manifests() {  # manifests NAME A B C: one dependency line per language
    tree "$1" check-rungs
    printf '[workspace.dependencies]\n%s\n' "$2" > "$t/Cargo.toml"  # name-ok
    printf 'module urshanabi\n\ngo 1.27\n\nrequire (\n%s\n\tgolang.org/x/sys v0.1.0 // indirect\n)\n' "$3" > "$t/go.mod"  # name-ok
    printf '[dependency-groups]\ntools = [\n%s\n]\n' "$4" > "$t/pyproject.toml"  # name-ok
}
good_systems='thing = "1.0"  # rung 2: the canonical thing'
good_services='	example.com/thing v1.0.0 // rung 2: the canonical thing'
good_pipeline='    "thing==1.0",  # rung 2: the canonical thing'
manifests u1 "$good_systems" "$good_services" "$good_pipeline"
expect pass "dependencies recording their rungs pass" "$t/script/check-rungs"
manifests u2 'thing = "1.0"' "$good_services" "$good_pipeline"
expect_msg fail "a dependency without a rung fails" "Cargo.toml: thing: records no rung" "$t/script/check-rungs"  # name-ok
manifests u3 "$good_systems" '	example.com/thing v1.0.0' "$good_pipeline"
expect_msg fail "a module without a rung fails" "go.mod: example.com/thing: records no rung" "$t/script/check-rungs"  # name-ok
manifests u4 "$good_systems" "$good_services" '    "thing==1.0",'
expect_msg fail "a tool without a rung fails" "pyproject.toml: thing: records no rung" "$t/script/check-rungs"  # name-ok
manifests u5 'thing = "1.0"  # rung 3: chosen after comparing' "$good_services" "$good_pipeline"
expect_msg fail "a compared choice citing no roadmap item fails" "cites no roadmap item" "$t/script/check-rungs"
manifests u6 'thing = "1.0"  # rung 4: made up' "$good_services" "$good_pipeline"
expect_msg fail "an unknown rung fails" "records no rung" "$t/script/check-rungs"


# --- script/test: the fast tier needs nothing outside the repository --
# (roadmap R-02). A component's tests run with every variable that could
# name an external service or credential cleared.
prereq() {  # prereq NAME: a tree with one check and one component
    tree "$1" test each-component
    printf '#!/bin/sh\nexit 0\n' > "$t/script/check-nothing" && chmod +x "$t/script/check-nothing"
    component thing
}
prereq q1
printf '#!/bin/sh\necho "thing: tests passed."\n' > "$t/thing/script/test" && chmod +x "$t/thing/script/test"
expect pass "a component needing nothing outside the repository passes" "$t/script/test"

prereq q2
cat > "$t/thing/script/test" <<'NEEDSDATABASE'
#!/bin/sh
[ -n "${DATABASE_URL:-}" ] || { echo "thing: FAILED: no database"; exit 1; }
NEEDSDATABASE
chmod +x "$t/thing/script/test"
DATABASE_URL=postgres://somebody/somewhere  # name-ok
export DATABASE_URL
expect_msg fail "a test quietly using an external service fails the fast tier" "FAILED: no database" "$t/script/test"

prereq q3
cat > "$t/thing/script/test" <<'NEEDSKEY'
#!/bin/sh
[ -n "${AWS_SECRET_ACCESS_KEY:-}" ] || { echo "thing: FAILED: no key"; exit 1; }
NEEDSKEY
chmod +x "$t/thing/script/test"
AWS_SECRET_ACCESS_KEY=not-a-real-key  # name-ok
export AWS_SECRET_ACCESS_KEY
expect_msg fail "a test quietly using a credential fails the fast tier" "FAILED: no key" "$t/script/test"
unset DATABASE_URL AWS_SECRET_ACCESS_KEY  # name-ok


# --- check-decomposition: a process exists for a reason (R-80) --------
deployed() {  # deployed NAME REASON: one service whose README gives REASON
    tree "$1" check-decomposition
    mkdir -p "$t/services/thing"
    printf '# Thing\n\n- **Holds:** something\n%s\n' "$2" > "$t/services/thing/README.md"
}
deployed d1 '- **Separate because:** it alone holds the source credentials (R-80)'
expect pass "a service naming what it alone holds passes" "$t/script/check-decomposition"
deployed d2 '- **Separate because:** a measurement showed one process could not keep
  up (R-80)'
expect pass "a service citing a measurement passes" "$t/script/check-decomposition"
deployed d3 '- **Speaks to:** everyone'
expect_msg fail "a service recording no reason fails" "does not record why it is a separate process" "$t/script/check-decomposition"
deployed d4 '- **Separate because:** it felt cleaner this way'
expect_msg fail "a reason that is neither a boundary nor a measurement fails" "names neither" "$t/script/check-decomposition"
tree d5 check-decomposition
expect_msg fail "a tree with no services fails" "no services found" "$t/script/check-decomposition"


# --- check-dependencies: the register and the allowlist (H4a, R-85) ---
registered() {  # registered NAME LICENCE SHIPPED [omit]: one dependency
    tree "$1" check-dependencies
    printf '[workspace.dependencies]\nthing = "1.0"  # rung 2: the canonical thing\n' > "$t/Cargo.toml"  # name-ok
    printf 'module urshanabi\n\ngo 1.27\n' > "$t/go.mod"  # name-ok
    printf '[project]\nname = "u"\n' > "$t/pyproject.toml"  # name-ok
    {
        printf '[thing]\nlicence = %s\n' "$2"
        [ "${4:-}" = omit ] || printf 'governance = one organisation\n'
        printf 'exit = behind our own module\ndisconnection = a library\nsupply-chain = a registry\nshipped = %s\n' "$3"
    } > "$t/script/dependencies.register"
}
registered v1 MIT yes  # name-ok
expect pass "a permissive licence with a full entry passes" "$t/script/check-dependencies"
registered v2 MIT yes omit  # name-ok
expect_msg fail "an entry missing a field fails" "records no governance" "$t/script/check-dependencies"
registered v3 BUSL-1.1 yes  # name-ok
expect_msg fail "a source-available licence is refused" "source-available" "$t/script/check-dependencies"
registered v4 GPL-3.0-only yes  # name-ok
expect_msg fail "strong copyleft that ships inside a cell is refused" "ships inside a cell" "$t/script/check-dependencies"
registered v5 GPL-3.0-only no  # name-ok
expect pass "strong copyleft that never reaches a cell passes" "$t/script/check-dependencies"
registered v6 MIT yes  # name-ok
printf '[workspace.dependencies]\nthing = "1.0"\nother = "2.0"\n' > "$t/Cargo.toml"  # name-ok
expect_msg fail "a dependency with no entry fails" "no entry in the register" "$t/script/check-dependencies"


# --- check-unused: a library ships with its caller (R-33) -------------
library() {  # library NAME README-EXTRA: one library component
    tree "$1" check-unused
    mkdir -p "$t/libs/thing" "$t/services/user"
    printf '# Thing\n\n- **Speaks to:** nothing\n%s\n' "$2" > "$t/libs/thing/README.md"
    printf '//! A library.\n' > "$t/libs/thing/lib.rs"
    printf '# User\n' > "$t/services/user/README.md"
    (cd "$t" && git add -A >/dev/null 2>&1)  # name-ok
}
library w1 ''
expect_msg fail "a library nothing uses, recording nothing, fails" "does not record why it is ahead" "$t/script/check-unused"
library w2 '- **Ahead of its caller:** its caller has not been written yet'
expect_msg fail "a library ahead of its caller citing no roadmap item fails" "cites no roadmap item" "$t/script/check-unused"
library w3 '- **Ahead of its caller:** the owner asked for it first (R-51)'
expect pass "a library recording why it is ahead of its caller passes" "$t/script/check-unused"
library w4 ''
printf '[dependencies]\nthing = { path = "../../libs/thing" }\n' > "$t/services/user/Cargo.toml"  # name-ok
(cd "$t" && git add -A >/dev/null 2>&1)  # name-ok
expect pass "a library a component depends on passes with no record" "$t/script/check-unused"
tree w5 check-unused
expect_msg fail "a tree with no libraries fails" "no library components" "$t/script/check-unused"

# Guard: a self-test whose helper is missing or misspelled fails with
# "not found" and records nothing. Count the calls written in this file
# and require that every one ran.
written=$(grep -c -E '^[[:space:]]*expect[a-z_]* (pass|fail) ' "$repo/script/check-scripts")
if [ "$ran" -ne "$written" ]; then
    echo "SELF-TEST FAILED: $written self-tests are written but $ran ran"
    failed="$failed [every written self-test runs]"
fi

if [ -n "$failed" ]; then
    echo "check-scripts FAILED:$failed"
    exit 1
fi
echo "check-scripts: $passed self-tests passed."
