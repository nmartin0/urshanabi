#!/bin/sh
# script/check-scale: the scale objectives in docs/scale.md stay honest
# (roadmap R-66). Every objective has a unique id, a target with a
# number and a unit, and at least one roadmap item. An objective marked
# tested must cite an executable load test under load/; an untested
# one cites none.
set -u
cd "$(dirname "$0")/.." || exit 1
[ -f docs/scale.md ] || { echo "FAIL: docs/scale.md is missing"; exit 1; }

awk '
function trim(s) { sub(/^[ \t]+/, "", s); sub(/[ \t]+$/, "", s); return s }
function fail(msg) { print "SCALE " id ": " msg; bad = 1 }
/^\| SO-/ {
    split($0, f, "|")
    id = trim(f[2]); what = trim(f[3]); target = trim(f[4])
    road = trim(f[5]); status = trim(f[6]); evid = trim(f[7])
    rows++
    if (id !~ /^SO-[0-9]+$/) fail("malformed id")
    if (id in seen) fail("id appears twice")
    seen[id] = 1
    if (what == "") fail("no objective")
    if (target !~ /[0-9]/ || target !~ /[0-9][0-9,.]* [a-z]/)
        fail("target needs a number and a unit")
    if (road !~ /R-[0-9]+/) fail("names no roadmap item")
    if (status == "untested") {
        if (evid != "—") fail("an untested objective cites no evidence; use —")
        untested++
    } else if (status == "tested") {
        tested++
        if (evid !~ /^`load\/[^`]+`$/) { fail("tested without a load test under load/"); next }
        p = substr(evid, 2, length(evid) - 2)
        if (system("test -x \"" p "\"") != 0) fail("load test " p " is not executable")
    } else fail("unknown status: " status)
}
END {
    if (rows == 0) { print "FAIL: no objectives found"; exit 1 }
    if (bad) exit 1
    printf "check-scale: %d objectives, %d tested, %d awaiting load tests.\n", rows, tested, untested
}' docs/scale.md
